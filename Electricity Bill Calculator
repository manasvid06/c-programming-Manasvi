#include<stdio.h>
void main()
{
    float units,bill;

    clrscr();

    printf("Enter electricity units: ");
    scanf("%f",&units);

    if(units<=100)
    {
        bill=units*2;
    }
    else if(units<=200)
    {
        bill=(100*2)+((units-100)*3);
    }
    else if(units<=300)
    {
        bill=(100*2)+(100*3)+((units-200)*4);
    }
    else
    {
        bill=(100*2)+(100*3)+(100*4)+((units-300)*5);
    }

    printf("Electricity Bill = Rs. %.2f",bill);

    getch();
}
