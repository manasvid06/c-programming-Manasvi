#include <stdio.h>

void main()
{
    int i, j;

    for(i = 1; i <= 7; i++)
    {
        for(j = 1; j <= 13; j++)
        {
            if(i == 1 || i == 7 || j == 1 || j == 13)
                printf("*");
            else if(i == 3 && (j == 4 || j == 10))
                printf("*");
            else if(i == 5 && (j >= 4 && j <= 10))
                printf("*");
            else
                printf(" ");
        }
        printf("\n");
    }
}
