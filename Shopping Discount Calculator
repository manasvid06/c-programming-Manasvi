#include<stdio.h>
void main()
{
    float amount,discount,total;

    clrscr();

    printf("Enter shopping amount: ");
    scanf("%f",&amount);

    if(amount>=5000)
    {
        discount=amount*20/100;
    }
    else if(amount>=3000)
